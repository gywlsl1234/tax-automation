# Supabase 프로젝트 설정 (Project Settings > API / Database에서 확인)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth 설정 (관리자 로그인)
# 생성: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# 관리자 계정 (평문 비밀번호는 절대 저장하지 않는다)
# 해시 생성: node scripts/generate-admin-hash.mjs "<비밀번호>"
# 주의: Next.js는 .env의 $VAR를 변수 참조로 확장하므로 bcrypt 해시의 '$'는
# 반드시 '\$'로 이스케이프해서 넣어야 한다 (스크립트 출력값을 그대로 사용).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
